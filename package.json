{
  "name": "@standhigher/bshopify",
  "version": "0.1.2",
  "description": "BestFulfill Shopify App Runner CLI.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "bshopify": "./dist/cli.js",
    "bs": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/azunyamazing/bshopify.git"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:dist",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "verify:dist": "node dist/cli.js --help",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.6.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
